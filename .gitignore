/target

# Claude Code's session locks and agent worktrees, but for the project's
# settings. Each worktree has a .git of its own, so `git add -A` would
# stage it as an embedded repository.
/.claude/*
!/.claude/settings.json
# Notes for agents working on clackatoo, kept by each checkout.
/CLAUDE.md

# insta snapshots waiting to be reviewed
*.snap.new
*.pending-snap

# Profiles and crashes
*.profraw
*.profdata
perf.data
perf.data.old
core
core.[0-9]*

# Editors
.idea/
.vscode/
*.swp
*~
