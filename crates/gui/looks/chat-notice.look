# Subagents finishing, shown as a card, and a message from another
# chat's agent, shown as a quote (CLACKA-230).
size 1100x900
keys <C-;>:Agent claude<CR>
keys i
type mcp start_chat {"prompt":"Find where turns are drawn","profile":"explore"}
keys <S-CR>
type mcp start_chat {"prompt":"usage-limit"}
keys <CR>
wait-for subagents finished
sleep 500
shot notice-folded
keys <C-;>gg/Find where<CR>nza
sleep 500
shot notice-open
keys <C-?>
type answer
sleep 300
shot notice-help
keys <Esc>
keys zMi
type mcp start_chat {"prompt":"Look at the parser","show":true}
keys <CR>
wait-for echo: Look at the parser
sleep 500
shot message-quoted
