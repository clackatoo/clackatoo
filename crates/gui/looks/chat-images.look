# Clipboard attachments in the real chat UI, using a stand-in clipboard.
size 1100x800
keys <C-;>:Agent claude<CR>
keys i
paste-image
type What do you see?
shot image-draft
keys <CR>
wait-for echo: What do you see?
shot image-sent
paste-image
paste-image
shot two-images
keys <BS>
shot removed-image
keys <CR>
wait-for echo:
shot image-only

# Small panes, scrolled images, and multiple thumbnails in the draft.
size 620x440
shot narrow-history
scroll 400 150 2
shot clipped-history
paste-image
paste-image
paste-image
paste-image
shot four-images
keys <BS><BS><BS><BS>
shot cleared-draft
