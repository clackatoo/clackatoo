# The MCP Servers page: its list, a server's form with what can be done
# about its connection, a change waiting to be saved and the question
# before it's thrown away, a field with something wrong, a private
# credential, and the list and a form in narrow windows.
size 1280x900
file .agents/mcp.json <<END
{"servers":{"docs":{"url":"https://mcp.example.org/mcp","headers":{"Authorization":{"secret":"docs-token"}}},"search":{"command":"search-server","args":["--stdio","--root","/srv/my notes"],"read_only":true}}}
END
keys <C-;>:Settings<CR>
wait-for Appearance
keys }}}}}}}}
wait-for Add a server
shot mcp-servers
# The second server, which runs a command.
keys j<CR>
wait-for Connects by
shot mcp-server
# On to its command, past what only says something, and more typed.
keys <Tab><Tab>
type -changed
shot mcp-typing
keys <CR>
shot mcp-changed
# Esc asks before the change goes.
keys <Esc>
shot mcp-discard
# A timeout that's no number says so under its field; Enter there stays
# there, as Remove is next.
keys <Tab><Tab><Tab><Tab><Tab>
type x
keys <CR>
shot mcp-wrong
keys <Esc><Esc>
wait-for Add a server
# A server to add, by its button.
keys a
wait-for New server
shot mcp-new
keys <Esc>
# A private credential, drawn as dots.
keys jj<CR>
wait-for Private credential
type docs-token
keys <Tab>
type never-show-this-private-value
shot mcp-private-credential
keys <CR>
shot mcp-private-credential-typed
keys <Esc><Esc>
wait-for Add a server
size 800x780
shot mcp-800
keys ggj<CR>
wait-for Connects by
shot mcp-server-800
size 640x780
shot mcp-server-640
keys <Esc>
shot mcp-640
