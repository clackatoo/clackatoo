# The Skills page: shared skills, where each is from and who starts it,
# each with its switch; one switched off; those that aren't loaded, with
# why; found by a search; and narrow.
size 1280x800
file .agents/skillsets/database/skillset.toml <<END
format = 1
name = "database"
description = "Database migration procedures."
version = "0.1.0"
END
file .agents/skillsets/database/skills/migrate-db/SKILL.md <<END
---
name: migrate-db
description: Create a database migration and check that existing data remains readable.
---
Read the schema, write the migration and test it against existing fixtures.
END
file .agents/skills/deploy-service/SKILL.md <<END
---
name: deploy-service
description: Prepare a release for deployment when explicitly requested.
disable-model-invocation: true
---
Check the release before deploying it.
END
file .agents/skills/investigate/SKILL.md <<END
---
name: investigate
description: Investigate a problem in a separate Claude session.
context: fork
---
Research the reported problem.
END
file .agents/skills/broken/SKILL.md <<END
no front matter here
END
# The project's own load only once its folder is trusted.
keys <C-;>
type :trust $PROJECT
keys <CR>
sleep 500
keys :Settings<CR>
wait-for Appearance
shot general
keys }}}}}}}
wait-for /migrate-db
shot skills
# One switched off, by its switch.
keys <CR>
sleep 600
shot skill-off
keys G
shot skills-not-loaded
keys /migration
shot skills-search
# One Esc clears the search; another would close the menu.
keys <Esc>
wait-for /deploy-service
size 640x700
shot skills-640
keys G
shot skills-not-loaded-640
