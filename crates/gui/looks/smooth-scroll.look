open rows.txt
shot editor-before
scroll-pixels 400 250 -10
shot editor-half-row
scroll 400 250 -3
shot editor-settled
keys <C-;>:Explore<CR>
shot explorer-before
scroll-pixels 100 250 -10
shot explorer-half-row
open readme.md
keys <C-;>:Markdown<CR>
scroll-pixels 400 250 -10
shot markdown-pixels
keys <C-;>:Terminal<CR>
keys i
shell seq 1 100
wait-for 100
scroll 400 250 4
shot terminal-history
scroll-pixels 400 250 10
shot terminal-half-row
keys <C-;>:Agent claude<CR>
keys i
type polish
keys <CR>
wait-for Image previews are ready
type polish
keys <CR>
type polish
keys <CR>
scroll 400 250 2
shot chat-settled
scroll-pixels 400 250 -10
shot chat-pixels
scale 2
open rows.txt
scroll-pixels 400 250 -10
shot editor-hidpi
