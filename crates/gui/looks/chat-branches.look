# Rewinding a chat (CLACKA-198): dG names the turn and asks about its
# files, the new branch's row, the switcher where branches part, [b asking
# to redo what leaving the branch undid, cc naming the message it puts
# back in the box, and narrow.
size 1000x750
file note.txt <<END
before
END
keys <C-;>:Agent claude<CR>
keys i
type remember APPLE
keys <CR>
wait-for echo: remember APPLE
type write $PROJECT/note.txt
keys <S-CR>
type after
keys <CR>
wait-for wrote
keys <C-;>dG
shot asked
keys y
sleep 500
shot rewound
keys i
type remember BANANA
keys <CR>
wait-for echo: remember BANANA
shot switcher
keys <C-;>[b
sleep 300
shot switch-asked
keys y
wait-for wrote
shot switched-back
keys gg
keys cc
sleep 300
shot edit-asked
keys n
sleep 500
shot edit-box
size 300x750
shot narrow
