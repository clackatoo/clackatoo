# The command line, with what it suggests.
size 1280x800
keys <C-;>:
shot command
type Ex
shot command-typed
keys <Tab>
shot command-tab
keys <C-u>
type set nu
shot command-options-live
keys <Tab>
shot command-choices
keys <Esc>
keys :set wrap<CR>
keys :se
keys <Up>
shot command-history
keys <Esc>

keys <Esc>
file src/main.rs <<END
fn main() {}
END
open src/main.rs
keys :e
type  ../s
shot command-files-live
keys <Esc>
size 640x480
keys :set nu
shot command-narrow
