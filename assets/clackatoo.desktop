[Desktop Entry]
Type=Application
Name=clackatoo
GenericName=Terminal
Comment=A fast, lightweight terminal workspace
Keywords=terminal;shell;console;command;prompt;editor;agent;workspace;
Exec=clackatoo open -- %F
TryExec=clackatoo
Icon=clackatoo
Terminal=false
Categories=System;TerminalEmulator;
MimeType=inode/directory;text/plain;text/markdown;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/rust;text/x-go;text/x-java;text/css;text/javascript;application/javascript;application/json;application/xml;application/x-yaml;application/toml;application/x-shellscript;
StartupWMClass=clackatoo
StartupNotify=true
Actions=new-window;connect;

[Desktop Action new-window]
Name=New Window
Exec=clackatoo

[Desktop Action connect]
Name=Connect to…
Exec=clackatoo --connect-picker
